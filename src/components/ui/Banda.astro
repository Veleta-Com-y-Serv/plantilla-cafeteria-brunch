---
// Banda a todo el ancho de la ventana (fondo pleno de borde a borde) con el contenido en el contenedor ancho
// (90 rem, 16 px de margen en móvil). `color`: crema | clara | suave | cafe | oscura | mostaza.
// `feston`: semicírculos de toldo del color de la banda asomando sobre la anterior.
interface Props { id?: string; color?: string; feston?: boolean; class?: string; etiqueta?: string; contenedor?: boolean }
const { id, color = 'crema', feston = false, class: clase = '', etiqueta, contenedor = true } = Astro.props;
---

<section id={id} class:list={['banda', `banda--${color}`, { feston }, clase]} aria-label={etiqueta}>
  {contenedor ? <div class="contenedor"><slot /></div> : <slot />}
</section>
