---
// Carta en banda café (como una pizarra) con festón de toldo arriba.
// 1) Bloque del brunch a sangre: foto (`imagen`) hasta el borde izquierdo y, al lado, el `menu_dia`
//    {titulo, precio, texto (una línea por plato)} sobre mostaza. Sin foto, el bloque ocupa todo el ancho; sin menú, no hay bloque.
// 2) `platos` [{nombre, texto, precio, categoria, destacado}] agrupados por `categoria` (en el orden en que aparecen):
//    la categoría a la izquierda y los platos en rejilla de 1-3 columnas. Sin precio no hay etiqueta de precio;
//    `destacado: true` pone la marca (texto en `marca_destacado`, por defecto «Favorito de la casa»).
import { seccion, agrupar, lineas } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Banda from '../ui/Banda.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const grupos = s ? agrupar(s.platos, (p) => p.categoria) : [];
const marca = (s?.marca_destacado as string | undefined)?.trim() || 'Favorito de la casa';
const m = s?.menu_dia;
---

{
  s && (
    <Banda id={Astro.props.id} color="cafe" feston contenedor={false}>
      {(s.titulo || s.antetitulo || s.texto) && (
        <div class="contenedor cabeza">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} />
          {s.texto && <p class="titular-texto">{s.texto}</p>}
        </div>
      )}
      {m && (
        <div class:list={['brunch', { 'brunch--con-foto': s.imagen }]}>
          {s.imagen && (
            <div class="brunch-foto">
              <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} />
            </div>
          )}
          <div class="brunch-bloque">
            <div class="brunch-cabeza">
              {m.titulo && <h3 class="brunch-titulo">{m.titulo}</h3>}
              {m.precio && <p class="brunch-precio">{m.precio}</p>}
            </div>
            {lineas(m.texto).length > 0 && (
              <ul class="brunch-lineas">
                {lineas(m.texto).map((l) => <li>{l}</li>)}
              </ul>
            )}
          </div>
        </div>
      )}
      {!m && s.imagen && (
        <div class="brunch">
          <div class="brunch-foto min-h-[22rem] md:min-h-[32rem]">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1920} alto={820} />
          </div>
        </div>
      )}
      {grupos.length > 0 && (
        <div class="contenedor">
          {grupos.map((g) => (
            <section class="carta-grupo" aria-label={g.grupo || undefined}>
              {g.grupo ? <h3 class="carta-categoria">{g.grupo}</h3> : <span aria-hidden="true" />}
              <ul class="platos">
                {g.items.map((p) => (
                  <li class="plato">
                    <p class="plato-linea">
                      <span class="plato-nombre">{p.nombre}</span>
                      {p.precio && <span class="plato-precio">{p.precio}</span>}
                    </p>
                    {p.destacado && (
                      <p class="plato-marca">
                        <Icono nombre="estrella" tam={13} class="fill-current" /> {marca}
                      </p>
                    )}
                    {p.texto && <p class="plato-texto">{p.texto}</p>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )}
      {s.cta?.url && (
        <div class="contenedor">
          <p class="mt-10">
            <a class="btn btn--mostaza" href={s.cta.url} {...(/^https?:/.test(s.cta.url) && { rel: 'noopener', target: '_blank' })}>{s.cta.texto}</a>
          </p>
        </div>
      )}
    </Banda>
  )
}
